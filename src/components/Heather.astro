---

---

<header
  id="site-header"
  class="sticky top-0 flex justify-between items-center py-3 w-full max-w-200 px-4 sm:px-6 lg:px-8 z-50"
>
  <nav
    class="header-nav relative flex items-center justify-between w-full text-sm sm:text-base px-3 py-2 rounded-full transition-all duration-300"
  >
    <div
      class="nav-bg absolute inset-0 rounded-full -z-10 transition-all duration-300"
    >
    </div>
    <img class="rounded-full w-8 h-8" src="/Armi.jpg" alt="Armi Foto" />
    <div class="flex gap-4 sm:gap-8 lg:gap-12 text-sm sm:text-base pr-5">
      <a
        class="text-white/80 hover:text-[#F9BC16] transition-colors duration-200"
        href="#experiencia">Experiencia</a
      >
      <a
        class="text-white/80 hover:text-[#F9BC16] transition-colors duration-200"
        href="#proyectos">Proyectos</a
      >
      <a
        class="text-white/80 hover:text-[#F9BC16] transition-colors duration-200"
        href="#sobremi">Sobre mí</a
      >
    </div>
  </nav>
</header>

<style>
  .nav-bg {
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0),
      rgba(255, 255, 255, 0)
    );
    border: 1px solid transparent;
    box-shadow: none;
    opacity: 0;
    transition:
      opacity 0.4s ease,
      backdrop-filter 0.4s ease,
      background 0.4s ease,
      box-shadow 0.4s ease,
      border 0.4s ease;
    will-change: opacity, backdrop-filter;
  }

  #site-header.scrolled .nav-bg {
    opacity: 1;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.06),
      rgba(255, 255, 255, 0.01)
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
</style>

<script>
  const header = document.getElementById("site-header");

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle("scrolled", window.scrollY > 10);
  };

  onScroll();
  window.addEventListener("scroll", onScroll);
</script>
