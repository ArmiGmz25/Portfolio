---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import MediaLink from "../components/MediaLink.astro";
import LinkedIn from "../assets/icons/LinkedIn.astro";
import GitHub from "../assets/icons/GitHub.astro";
import Mail from "../assets/icons/Mail.astro";
import Experience from "../components/Experience.astro";
import Briefcase from "../assets/icons/Briefcase.astro";
import Code from "../assets/icons/Code.astro";
import Projects from "../components/Projects.astro";
import Footer from "../components/Footer.astro";
import AboutInfo from "../components/AboutInfo.astro";
import AboutMe from "../assets/icons/aboutMe.astro";
---

<Layout
  title="Portafolio de Armando Gómez - Desarrollador web y diseñador UX/UI"
>
  <main class="px-4">
    <Container class="py-15 lg:py-30">
      <h1
        class="text-xl xs:text-2xl sm:text-3xl md:text-4xl lg:text-4xl font-bold pb-2 leading-tight"
      >
        <span
          class="font-mono bg-linear-to-r from-[#A4AFFF] to-[#E5C0FF] bg-clip-text text-transparent text-center"
        >
          Hola Mundo! Soy Armando
        </span>
        👋
      </h1>
      <h2
        class="text-xl xs:text-2xl sm:text-3xl md:text-3xl lg:text-3xl font-bold text-zinc-200 pb-2 text-pretty"
      >
        Ingeniero Full Stack | Diseñador UX/UI
      </h2>
      <p
        class="sm:text-xl md:text-xl lg:text-xl font-mono bg-linear-to-r from-[#A4AFFF] to-[#E5C0FF] bg-clip-text text-transparent mb-6 mt-2 text-pretty"
      >
        Desarrollador web y diseñador enfocado en crear <span
          class="text-[#F9BC16]"
        >
          aplicaciones escalables
        </span>
        y <span class="text-[#F9BC16]"> experiencias centradas </span>
        en el usuario
      </p>

      <ul class="flex gap-x-3">
        <li class="flex gap-x-2">
          <MediaLink
            href="https://www.linkedin.com/in/armando-g%C3%B3mez-coria-b11871223/"
          >
            <LinkedIn class="w-5 h-5" />
            LinkedIn
          </MediaLink>
        </li>

        <li>
          <MediaLink href="https://github.com/ArmiGmz25">
            <GitHub class="w-5 h-5" />
            GitHub
          </MediaLink>
        </li>

        <li>
          <MediaLink href="mailto:ajgomezcoria@gmail.com">
            <Mail class="w-6 h-6" />
            Correo
          </MediaLink>
        </li>
      </ul>
    </Container>

    <Container class="pb-5" id="experiencia">
      <h2
        class="text-2xl lg:text-3xl mb-5 font-semibold flex gap-x-2 items-center text-white/95"
      >
        <Briefcase class="size-7" /> Experiencia Laboral
      </h2>
      <Experience />
    </Container>

    <Container class="" id="proyectos">
      <h2
        class="text-2xl lg:text-3xl mb-5 font-semibold flex gap-x-2 items-center text-white/95"
      >
        <Code class="size-7.5" /> proyectos
      </h2>
      <Projects />
    </Container>

    <Container class="pt-15 pb-15" id="sobremi">
      <h2
        class="text-2xl lg:text-3xl mb-1 font-semibold flex gap-x-2 items-center text-white/95"
      >
        <AboutMe class="size-7.5" /> Sobre Mí
      </h2>
      <AboutInfo />
    </Container>

    <footer>
      <Footer />
    </footer>
  </main>
</Layout>
